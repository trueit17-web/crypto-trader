# ============================================================
# CryptoTrader Platform — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ============================================================

# App
APP_NAME=CryptoTrader Platform
ENVIRONMENT=development   # development | staging | production
DEBUG=true

# PostgreSQL (TimescaleDB)
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cryptotrader

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth — GENERATE with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_USE_VAULT_IN_PROD

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Telegram (optional for MVP without Telegram)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Sentry (optional)
SENTRY_DSN=

# Grafana
GRAFANA_PASSWORD=admin

# Risk defaults (override per exchange/strategy in DB)
MAX_LEVERAGE=10
MAX_DAILY_DRAWDOWN=0.05
MAX_PORTFOLIO_EXPOSURE=0.20
